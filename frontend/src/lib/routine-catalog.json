    {
      "id": "plyo-tricking-power-main",
      "name": "Tricking power",
      "emoji": "figureRun",
      "excludeFromProgression": true,
      "ex": [
        {
          "id": "cplyo-tricking-warmup",
          "sets": 1,
          "mode": "time",
          "sec": 420,
          "weight": 0,
          "restSec": 30,
          "noProg": true,
          "note": "Main session, about 20–25 minutes. First 3 weeks: once weekly. Leave roughly 48–72 hours between demanding jumping days, including tricking class. Account for climbing and Pilates fatigue. If paired with climbing or Pilates, jump first while fresh. Warm up 6–8 minutes as described in the exercise details."
        },
        {
          "id": "9070",
          "sets": 2,
          "mode": "reps",
          "reps": 10,
          "weight": 0,
          "restSec": 90,
          "noProg": true,
          "note": "Small springy two-foot hops, mainly through the ankles. Keep knees slightly bent and body tall. Rest 60–90 seconds between sets."
        },
        {
          "id": "9513",
          "sets": 3,
          "mode": "reps",
          "reps": 3,
          "weight": 0,
          "restSec": 120,
          "noProg": true,
          "note": "Brief dip, strong arm swing, jump straight upward. Land with control. Reset 5–10 seconds between repetitions; rest 2 minutes between sets. Do not tuck the knees. FIRST SESSION ONLY: perform 2 sets and skip the third. Later sessions: 3 sets."
        },
        {
          "id": "11782",
          "sets": 2,
          "mode": "reps",
          "reps": 8,
          "weight": 0,
          "restSec": 90,
          "noProg": true,
          "note": "8 jumps TOTAL per set: 4 left and 4 right. Take off and land on BOTH feet. Keep jumps small; hold every landing for 2 seconds. Rest 90 seconds. Once consistently controlled, replace this exercise with short skater bounds: 2 sets of 3 PER SIDE (6 total per set), holding each single-leg landing. Increase distance gradually; do not add bounds on top."
        }
      ]
    },
